# ==============================================================================
# Autonomous Daily Project Factory - Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: gemini, openai, groq, anthropic, mock
LLM_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash

# API Keys (Provide at least one depending on LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Configuration
# Required for creating and pushing new project repositories
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username
GITHUB_ORGANIZATION=
GITHUB_DEFAULT_VISIBILITY=public

# Debugger & Resilience Settings
MAX_DEBUG_ATTEMPTS=5
EXECUTION_TIMEOUT_SECONDS=180

# Factory Paths
DATA_DIR=data
GENERATED_PROJECTS_DIR=generated_projects
LOGS_DIR=logs

# Feature Flags
DRY_RUN=false
SKIP_GITHUB=false
MOCK_LLM=false
